# Copy this file to /data/bin/qgisserver.env on the QGIS Server host or
# inside the QGIS Server container.
# This file contains deployment settings, not database credentials.

QGIS_DB_SERVICE=replace_with_service_name
QGIS_SERVER_BASE_URL=https://replace-with-qgis-host/qgis/
QGIS_SERVER_FCGI=/usr/lib/cgi-bin/qgis_mapserv.fcgi
PGSERVICEFILE=/data/config/pg_service.conf
